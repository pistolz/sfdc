{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ESNext",
  "jsx": "react-jsx",
  "strict": true,
  "noEmit": true,
  "lib": [
   "ES2022",
   "DOM"
  ],
  "moduleResolution": "Bundler",
  "esModuleInterop": true,
  "skipLibCheck": true,
  "resolveJsonModule": true
 },
 "include": [
  "src"
 ]
}