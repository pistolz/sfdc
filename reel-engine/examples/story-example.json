        { "type": "emoji", "char": "💧", "x": 780, "y": 980, "size": 150, "at": "supplies", "loop": "float", "delay": 0.2 },
        { "type": "emoji", "char": "🔦", "x": 540, "y": 820, "size": 150, "at": "supplies", "loop": "float" }
