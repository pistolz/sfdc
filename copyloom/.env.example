# ---------------------------------------------------------------------------
# Copyloom environment
#
# Copy to `.env.local` for local development:   cp .env.example .env.local
#
# In production NOTHING here is baked into the image. Cloud Run supplies the
# plain values as env vars and the two Stripe secrets from Secret Manager, so
# the same image can be promoted between environments unchanged.
#
# Note what is absent: there is no Anthropic API key and no GCP service-account
# JSON. Claude is reached through Vertex AI using Application Default
# Credentials (the Cloud Run runtime service account), and Firestore uses the
# same identity.
# ---------------------------------------------------------------------------

# --- Google Cloud ----------------------------------------------------------

# GCP project ID. Read by both the Vertex AI and Firestore clients.
# Cloud Run does NOT inject this by itself (that is App Engine / Cloud
# Functions behaviour), so the Terraform config and scripts/deploy.sh set it
# explicitly on the service — you do not manage it by hand in production.
# Locally, set it to the project you ran
# `gcloud auth application-default login` against.
GOOGLE_CLOUD_PROJECT=my-copyloom-project

# Vertex AI serving region for Claude. `global` is recommended: it routes
# across regions and has the best availability/quota. Use a specific region
# (e.g. us-east5, europe-west1) only if you have data-residency requirements —
# a model must be enabled in Model Garden for the region you pick.
VERTEX_REGION=global

# Claude model ID on Vertex AI. Vertex uses the bare model ID with no
# `publishers/anthropic/` or `anthropic.` prefix.
#
# IMPORTANT: Claude models are not on by default. Each one must be enabled
# manually for your project in the Google Cloud console under
# Vertex AI > Model Garden > Claude (see DEPLOY.md step 2). If Opus 5 is not
# enabled for your project, requests fail with a 404 "model not found" — set
# VERTEX_MODEL=claude-sonnet-5 as the fallback and everything else works
# unchanged.
VERTEX_MODEL=claude-opus-5

# --- Firebase Authentication ----------------------------------------------
# Both come from Firebase console > Project settings > General > "Your apps" >
# Web app > SDK setup and configuration. They are public by design (the API key
# only identifies the project; access is controlled by Firebase security rules
# and by server-side ID-token verification), but they are still passed at
# runtime rather than inlined at build time so one image serves every project.

# Firebase Web API key, e.g. AIzaSy...
FIREBASE_API_KEY=

# Firebase auth domain, normally <project-id>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=my-copyloom-project.firebaseapp.com

# --- Application -----------------------------------------------------------

# Absolute public origin, no trailing slash. Used to build Stripe checkout
# success/cancel redirect URLs. Locally http://localhost:8080; in production the
# Cloud Run service URL (or your custom domain) — see DEPLOY.md step 6, this is
# set on the second terraform apply once the URL exists.
APP_URL=http://localhost:8080

# --- Stripe ----------------------------------------------------------------

# Stripe secret key. Stripe dashboard > Developers > API keys > Secret key.
# Use sk_test_... locally and sk_live_... in production.
# In production this is stored in Secret Manager (secret `copyloom-stripe-secret-key`)
# and mounted into Cloud Run as an env var — never set as a plain env var.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the webhook endpoint. Two sources:
#   - local:      output of `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
#   - production: Stripe dashboard > Developers > Webhooks > your endpoint >
#                 "Signing secret" (DEPLOY.md step 7)
# Stored in Secret Manager as `copyloom-stripe-webhook-secret` in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs (price_..., NOT product prod_... ids) for the three paid
# plans defined in src/lib/plans.ts. Stripe dashboard > Product catalogue >
# the product > Pricing > the recurring monthly price > copy its API ID.
# Leave a plan's price unset to hide/disable it.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...
