---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../site.config';
import { getImage } from 'astro:assets';
import { getGames, toSearchRecord } from '../lib/games';

interface Props {
  title?: string;
  description?: string;
  /** Path under /public, e.g. /og/purrfect-stack.png */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
}
const { title, description = site.description, ogImage = '/og/default.png', ogType = 'website', noindex = false, jsonLd = [] } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline.replace(/\.$/, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogUrl = new URL(ogImage, Astro.site ?? site.url).href;
const games = await getGames();
// Search records carry a small optimised icon (96px webp) so results show the real game icon.
const searchRecords = await Promise.all(
  games.map(async (g) => ({
    ...toSearchRecord(g),
    i: g.data.icon ? (await getImage({ src: g.data.icon, width: 96, height: 96, format: 'webp' })).src : undefined,
  })),
);
const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: site.name,
      url: `${site.url}/`,
      logo: `${site.url}/brand/whiskerworks-mark-512.png`,
      email: site.email,
      slogan: site.tagline,
      sameAs: Object.values(site.socials).filter(Boolean),
    },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.name, publisher: { '@id': `${site.url}/#organization` } },
  ],
};
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <meta name="robots" content="index,follow,max-image-preview:large" />}
    <meta name="theme-color" content="#fff8ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {site.analytics.plausibleDomain && (
      <script defer data-domain={site.analytics.plausibleDomain} src="https://plausible.io/js/script.outbound-links.js"></script>
    )}
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header gameCount={games.length} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog records={searchRecords} />
    <script>
      // Reveal-on-scroll + header state. Progressive: content is visible without JS.
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      const onScroll = () => document.documentElement.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      // Close the mobile menu after navigating within the page.
      document.querySelectorAll<HTMLDetailsElement>('[data-menu]').forEach((m) =>
        m.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) m.open = false; }),
      );
      // Analytics: one helper for GA4 (window.wwTrack) and Plausible. No-op when both are off.
      type W = { wwTrack?: (n: string, p?: object) => void; plausible?: (n: string, o?: object) => void };
      const track = (name: string, params: Record<string, string> = {}) => {
        const w = window as unknown as W;
        w.wwTrack?.(name, params);
        w.plausible?.(name, { props: params });
      };
      (window as unknown as { track: typeof track }).track = track;
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a, [data-event]');
        if (!a) return;
        if (a.dataset.event) track(a.dataset.event, { store: a.dataset.store ?? '', game: a.dataset.game ?? '', page: location.pathname });
        else if (a.href && a.host && a.host !== location.host) track('outbound_click', { link_url: a.href, link_domain: a.host, page: location.pathname });
      });
    </script>
  </body>
</html>
