---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
const faq = [
  { q: 'I bought an unlock. How do I restore it on a new phone?', a: 'Open the game, go to Settings and tap “Restore purchases”. Make sure you are signed in with the same Apple ID or Google account you used to buy it.' },
  { q: 'Do your games have ads?', a: 'No. None of our games show ads, and they never will.' },
  { q: 'Do I need an account?', a: 'No. Every game works without an account. Some games offer optional sync, which uses your Apple or Google account.' },
  { q: 'How do I get a refund?', a: 'Purchases are processed by Apple and Google, so refunds go through them: reportaproblem.apple.com for iPhone, or your Google Play order history for Android. If something is wrong with a game, email us first: we will try to fix it.' },
  { q: 'How do I delete my data?', a: `Email ${site.email} from any address with the game name and, if you used sync, your player ID (Settings → About). We delete it within 30 days and confirm by email.` },
  { q: 'I found a bug!', a: `Thank you! Email ${site.email} with the game, your device and what happened. A screenshot or screen recording helps a lot.` },
];
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Support" description="Help with WhiskerWorks games: restoring purchases, refunds, data deletion and contact." jsonLd={[ld]}>
  <section class="section-tight">
    <div class="container two">
      <div class="stack">
        <p class="kicker">Support</p>
        <h1 class="display" style="font-size:clamp(2.4rem,5vw,4rem)">How can we help?</h1>
        <p class="lede">Most answers are below. If not, a real person replies to every email, usually within two working days.</p>
        <p><a class="btn" href={`mailto:${site.email}?subject=Support`}>Email support</a></p>
      </div>
      <div class="faq">
        {faq.map((f) => <details><summary>{f.q}</summary><div><p>{f.a}</p></div></details>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .two { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 2rem 4rem; align-items: start; padding-block: 1rem 2rem; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
</style>
