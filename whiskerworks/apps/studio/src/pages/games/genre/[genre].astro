---
import Base from '../../../layouts/Base.astro';
import GameCard from '../../../components/GameCard.astro';
import { getGames, slugify, gameUrl, type Game } from '../../../lib/games';
import { site } from '../../../site.config';

export async function getStaticPaths() {
  const games = await getGames();
  const by = new Map<string, Game[]>();
  for (const g of games) by.set(g.data.genre, [...(by.get(g.data.genre) ?? []), g]);
  return [...by].map(([genre, list]) => ({ params: { genre: slugify(genre) }, props: { genre, list, all: games } }));
}
interface Props { genre: string; list: Game[]; all: Game[] }
const { genre, list, all } = Astro.props;
const plural = /s$/i.test(genre) ? genre : `${genre} games`;
const others = [...new Set(all.map((g) => g.data.genre))].filter((g) => g !== genre).sort();
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${plural} by ${site.name}`,
  url: new URL(`/games/genre/${slugify(genre)}/`, site.url).href,
  mainEntity: { '@type': 'ItemList', itemListElement: list.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.data.title, url: new URL(gameUrl(g), site.url).href })) },
};
---
<Base title={`Free ${plural.toLowerCase()} for iPhone & Android`} description={`${list.length} free ${plural.toLowerCase()} by ${site.name}: ${list.map((g) => g.data.title).join(', ')}. Download on the App Store and Google Play.`} ogImage="/og/games.png" jsonLd={[ld]}>
  <section class="head">
    <div class="container">
      <nav aria-label="Breadcrumb" class="crumbs"><a href="/games/">Games</a> / {genre}</nav>
      <p class="kicker">{list.length} game{list.length === 1 ? '' : 's'}</p>
      <h1 class="display">Free {plural.toLowerCase()}.</h1>
      <p class="lede">Hand-made {plural.toLowerCase()} for iPhone and Android, free to play. Pick one, you’ll be playing in ten seconds.</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container">
      <div class="game-grid">{list.map((g) => <GameCard game={g} headingLevel="h2" />)}</div>
      {others.length > 0 && (
        <nav class="others" aria-label="Other genres">
          <h2 class="h3">More genres</h2>
          <div class="chips">{others.map((o) => <a class="chip" href={`/games/genre/${slugify(o)}/`}>{o}</a>)}</div>
        </nav>
      )}
    </div>
  </section>
</Base>
<style>
  .head { padding: clamp(2rem, 5vw, 4rem) 0 1rem; }
  .crumbs { font-weight: 600; color: var(--ww-ink-3); margin-bottom: 1rem; }
  .crumbs a { color: var(--ww-ink); }
  .display { margin: 0.8rem 0 1rem; }
  .others { margin-top: 3rem; display: grid; gap: 1rem; }
</style>
