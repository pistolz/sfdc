---
import Base from '../../layouts/Base.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { getSeries } from '../../lib/series';
import SocialLinks from '../../components/SocialLinks.astro';
import { getFlagWarsSnapshot } from '../../lib/flagwars';
import { site } from '../../site.config';

const s = getFlagWarsSnapshot();
const all = getSeries();
const episodes = [...s.episodes].sort((a, b) => b.day - a.day).slice(0, 6);
const faq = [
  { q: 'Is it free to take part?', a: 'Yes. All you do is comment on an episode. There is nothing to buy, no app to install and no account to create on our side.' },
  { q: 'How are comments, likes and follows counted?', a: 'Each series has one simple rule, written in its title: 1 comment = 1 flag, 1 club = 1 stand, 1 follower = 1 arcade machine, 1 comment = 1 level up, 1 like = 1 floor. We count everything on the latest episode, and the first person to start something (a country, a club…) becomes its Founder. Live maps update once a day, right before the next episode.' },
  { q: 'Which platforms count?', a: 'Comments on the official episode posts count, on every platform where we publish the series. Links to each platform are on the live map.' },
  { q: 'Can I remove my name from the map?', a: `Of course. Email ${site.email} with your handle and we will replace it with “anonymous” at the next update.` },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Live series" description="Flag Wars, Stadium Builder, Insert Coin Club, Noob Bee and Level Tower: daily videos on Instagram, TikTok and YouTube where your comments decide what happens next." ogImage="/og/series.png" jsonLd={[faqLd]}>
  <section class="head">
    <div class="container">
      <p class="kicker">Live series</p>
      <h1 class="display">Shows you play<br />from the comments.</h1>
      <p class="lede">Our live series are short daily videos where the audience is the player. You comment, we count, and the next episode shows what you changed. The live map always shows exactly where things stand.</p>
    </div>
  </section>

  <section class="steps-wrap" aria-labelledby="how-title">
    <div class="container">
      <h2 id="how-title" class="sr-only">How it works</h2>
      <ol class="steps">
        <li data-reveal><span class="n">1</span><h3>Watch</h3><p>A new episode drops every day on Instagram, TikTok and YouTube.</p></li>
        <li data-reveal style="--reveal-delay:.07s"><span class="n">2</span><h3>Comment</h3><p>Name a country (or drop its flag emoji). One comment, one flag.</p></li>
        <li data-reveal style="--reveal-delay:.14s"><span class="n">3</span><h3>Change the story</h3><p>Tomorrow’s episode and the live map show what everyone decided.</p></li>
      </ol>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="all-title">
    <div class="container">
      <div class="section-head">
        <h2 id="all-title" class="h2">{all.length} series. All live.</h2>
        <p class="muted">Type your @name in any card to jump straight to it on the live map.</p>
      </div>
      <div class="series-grid">{all.map((x) => <SeriesCard s={x} />)}</div>
    </div>
  </section>

  {episodes.length > 0 && (
    <section class="section-tight rule-top" aria-labelledby="eps-title">
      <div class="container">
        <h2 id="eps-title" class="h2">Latest Flag Wars episodes</h2>
        <ol class="eps" reversed>
          {episodes.map((e) => (
            <li><span class="day">Day {e.day}</span><b>{e.title}</b>{e.summary && <span class="muted">{e.summary}</span>}</li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="section rule-top" aria-labelledby="faq-title">
    <div class="container two">
      <div>
        <h2 id="faq-title" class="h2">Questions about the series</h2>
        <p class="muted" style="margin-top:1rem">Follow along so you never miss an episode.</p>
        <div style="margin-top:1.2rem"><SocialLinks /></div>
      </div>
      <div class="faq">
        {faq.map((f) => <details><summary>{f.q}</summary><div><p>{f.a}</p></div></details>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .head { padding: clamp(2.5rem, 6vw, 5rem) 0 2rem; }
  .head .display { margin: 0.9rem 0 1.2rem; }
  .steps-wrap { padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .steps li { padding: 1.5rem; border: 2px solid var(--ww-ink); border-radius: var(--ww-radius-lg); background: var(--ww-paper-2); display: grid; gap: 0.5rem; align-content: start; }
  .steps .n { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--ww-marmalade); border: 2px solid var(--ww-ink); font-family: var(--ww-font-display); font-weight: 800; color: var(--ww-ink); }
  .steps h3 { font-size: 1.4rem; }
  .series-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); gap: 1.25rem; }
  .eps { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .eps li { display: grid; grid-template-columns: 6rem 1fr; gap: 0.2rem 1rem; padding: 1rem 0; border-top: 1.5px solid var(--ww-rule); }
  .eps .muted { grid-column: 2; }
  .day { font-family: var(--ww-font-display); font-weight: 700; color: var(--ww-marmalade-ink); font-size: 0.9rem; }
  .eps b { color: var(--ww-ink); }
  .two { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 2rem 4rem; }
  @media (max-width: 860px) { .steps, .two { grid-template-columns: 1fr; } }
</style>
