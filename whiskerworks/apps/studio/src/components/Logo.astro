---
interface Props {
  size?: number;
  withWordmark?: boolean;
  tone?: 'ink' | 'paper';
}
const { size = 36, withWordmark = true, tone = 'ink' } = Astro.props;
---
<span class:list={['logo', `logo-${tone}`]}>
  <svg class="mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="15" fill="#1A1424" />
    <path stroke="#FF7A2F" stroke-width="2.4" stroke-linecap="round" d="M4.5 33.5 17 36M3.5 40h13.5M5 46.5 17 43.5M59.5 33.5 47 36M60.5 40H47M59 46.5 47 43.5" />
    <path fill="#FFF8EE" d="M32 54c-13.5 0-21.5-7.2-21.5-17 0-5.6 1.9-10.6 5-14.4L14.6 9.2l10.8 6.6A27 27 0 0 1 32 15c2.3 0 4.5.3 6.6.8l10.8-6.6-.9 13.4c3.1 3.8 5 8.8 5 14.4 0 9.8-8 17-21.5 17Z" />
    <g class="eyes" fill="#1A1424"><ellipse cx="24.5" cy="31.5" rx="2.6" ry="3.4" /><ellipse cx="39.5" cy="31.5" rx="2.6" ry="3.4" /></g>
    <path fill="#FF7A2F" d="M29.6 37.2h4.8L32 39.8Z" />
    <path fill="none" stroke="#1A1424" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M26.2 41.2q2.9 3.6 5.8 0 2.9 3.6 5.8 0" />
  </svg>
  {withWordmark && <span class="wordmark">Whisker<b>Works</b></span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .mark { flex: none; border-radius: 22%; transition: transform var(--ww-dur) var(--ww-ease-spring); }
  .eyes { transform-origin: 32px 31.5px; animation: blink 6s infinite; }
  @keyframes blink { 0%, 46%, 50%, 100% { transform: scaleY(1); } 48% { transform: scaleY(0.1); } }
  .wordmark { font-family: var(--ww-font-display); font-weight: 600; font-size: 1.12rem; letter-spacing: -0.035em; color: var(--ww-ink); }
  .wordmark b { font-weight: 800; }
  .logo-paper .wordmark { color: var(--ww-paper); }
  a:hover .mark { transform: rotate(-8deg) scale(1.06); }
</style>
