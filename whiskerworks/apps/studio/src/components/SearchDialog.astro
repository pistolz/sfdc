---
import type { SearchRecord } from '../lib/games';
interface Props { records: (SearchRecord & { i?: string })[] }
const { records } = Astro.props;
const pages = [
  { t: 'Flag Wars live map', d: 'The live world map of our comment-powered series.', u: '/series/', k: ['flag wars', 'live series', 'map', 'comment', 'instagram', 'tiktok'] },
  { t: 'About the studio', d: 'Who we are and how we make games.', u: '/about/', k: ['studio', 'team', 'about', 'whiskerworks'] },
  { t: 'Support', d: 'Help, purchases, restoring unlocks and contact.', u: '/support/', k: ['help', 'contact', 'refund', 'restore', 'bug'] },
  { t: 'Press kit', d: 'Logos, facts and contact for press.', u: '/press/', k: ['press', 'logo', 'media', 'brand'] },
];
---
<dialog class="search" data-search aria-label="Search games">
  <form method="dialog" class="box" role="search" data-search-form>
    <div class="field">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      <input
        type="search"
        name="q"
        placeholder="Search games, genres, “word puzzle”…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        data-search-input
      />
      <button type="button" class="close" data-search-close aria-label="Close search">Esc</button>
    </div>
    <ul id="search-results" class="results" role="listbox" aria-label="Results" data-search-results></ul>
    <p class="hint" data-search-hint aria-live="polite"></p>
  </form>
</dialog>
<script type="application/json" id="search-data" set:html={JSON.stringify({ games: records, pages })}></script>

<script>
  type Rec = { t: string; d: string; u: string; g?: string; k?: string[]; s?: string; c?: string[]; m?: string; i?: string };
  const dialog = document.querySelector<HTMLDialogElement>('[data-search]')!;
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
  const list = dialog.querySelector<HTMLUListElement>('[data-search-results]')!;
  const hint = dialog.querySelector<HTMLParagraphElement>('[data-search-hint]')!;
  const data = JSON.parse(document.getElementById('search-data')!.textContent || '{}') as { games: Rec[]; pages: Rec[] };
  const all: (Rec & { kind: 'game' | 'page' })[] = [
    ...data.games.map((g) => ({ ...g, kind: 'game' as const })),
    ...data.pages.map((p) => ({ ...p, kind: 'page' as const })),
  ];

  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9 ]+/g, ' ').trim();
  function lev(a: string, b: string, max: number) {
    if (Math.abs(a.length - b.length) > max) return max + 1;
    let prev = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i++) {
      const cur = [i];
      let best = i;
      for (let j = 1; j <= b.length; j++) {
        cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
        best = Math.min(best, cur[j]);
      }
      if (best > max) return max + 1;
      prev = cur;
    }
    return prev[b.length];
  }
  const index = all.map((r) => {
    const title = norm(r.t);
    const body = norm([r.d, r.g ?? '', ...(r.k ?? [])].join(' '));
    return { r, title, body, words: Array.from(new Set(`${title} ${body}`.split(' ').filter(Boolean))) };
  });

  function search(q: string) {
    const terms = norm(q).split(' ').filter(Boolean);
    if (!terms.length) return index.filter((x) => x.r.kind === 'game').slice(0, 8).map((x) => x.r);
    const scored = index
      .map((x) => {
        let score = 0;
        for (const t of terms) {
          let s = 0;
          if (x.title.startsWith(t)) s = 12;
          else if (x.title.includes(t)) s = 9;
          else if (x.body.includes(t)) s = 5;
          else if (t.length >= 4 && x.words.some((w) => lev(t, w.slice(0, t.length + 1), 1) <= 1 || lev(t, w, 2) <= (t.length > 6 ? 2 : 1))) s = 2;
          if (!s) return { r: x.r, score: 0 };
          score += s;
        }
        if (x.r.kind === 'game' && x.r.s === 'live') score += 0.5;
        return { r: x.r, score };
      })
      .filter((x) => x.score > 0)
      .sort((a, b) => b.score - a.score);
    return scored.slice(0, 10).map((x) => x.r);
  }

  let active = 0;
  let current: Rec[] = [];
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  function render() {
    const q = input.value;
    current = search(q);
    active = 0;
    list.innerHTML = current
      .map((r, i) => {
        const swatch = r.c ? `background:linear-gradient(135deg,${r.c[0]},${r.c[1]})` : 'background:var(--ww-ink)';
        const meta = 'g' in r && r.g ? `${esc(r.g)}${r.s === 'live' ? '' : r.s === 'beta' ? ' · Beta' : r.s === 'soon' ? ' · Launching soon' : ' · In the workshop'}` : 'Page';
        return `<li role="option" id="sr-${i}" aria-selected="${i === 0}"><a href="${r.u}">${r.i ? `<img class="sw" src="${r.i}" alt="" width="42" height="42" loading="lazy" decoding="async">` : `<span class="sw" style="${swatch}"></span>`}<span class="tx"><b>${esc(r.t)}</b><small>${esc(r.d)}</small></span><span class="mt">${meta}</span></a></li>`;
      })
      .join('');
    input.setAttribute('aria-activedescendant', current.length ? 'sr-0' : '');
    hint.textContent = q && !current.length ? `Nothing for “${q}” yet. Try a genre like “puzzle” or a mood like “relax”.` : q ? `${current.length} result${current.length === 1 ? '' : 's'}` : 'Popular games';
  }
  function move(d: number) {
    if (!current.length) return;
    active = (active + d + current.length) % current.length;
    list.querySelectorAll('[role=option]').forEach((el, i) => el.setAttribute('aria-selected', String(i === active)));
    input.setAttribute('aria-activedescendant', `sr-${active}`);
    list.children[active]?.scrollIntoView({ block: 'nearest' });
  }
  function open(prefill = '') {
    if (dialog.open) return;
    input.value = prefill;
    render();
    dialog.showModal();
    input.focus();
  }
  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter') {
      e.preventDefault();
      (window as unknown as { track?: (n: string, p: object) => void }).track?.('search', { search_term: input.value.trim() });
      const r = current[active];
      if (r) window.location.href = r.u;
      else if (input.value.trim()) window.location.href = `/games/?q=${encodeURIComponent(input.value.trim())}`;
    }
  });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', () => open()));
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    const typing = t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
    if ((e.key === '/' && !typing) || (e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey))) {
      e.preventDefault();
      open();
    }
  });
</script>

<style>
  .search {
    width: min(40rem, calc(100vw - 2rem)); max-height: min(36rem, calc(100dvh - 4rem)); margin: 8vh auto auto; padding: 0;
    border: 2px solid var(--ww-ink); border-radius: var(--ww-radius-lg); background: var(--ww-paper); color: var(--ww-ink);
    box-shadow: 8px 8px 0 var(--ww-ink); overflow: hidden;
  }
  .search[open] { animation: pop var(--ww-dur) var(--ww-ease-out); }
  .search::backdrop { background: rgb(26 20 36 / 0.55); backdrop-filter: blur(3px); }
  @keyframes pop { from { opacity: 0; transform: translateY(10px) scale(0.98); } }
  .box { display: flex; flex-direction: column; max-height: inherit; }
  .field { display: flex; align-items: center; gap: 0.75rem; padding: 0.9rem 1rem; border-bottom: 1.5px solid var(--ww-rule); }
  .field svg { width: 1.3rem; height: 1.3rem; flex: none; color: var(--ww-ink-3); }
  .field input { flex: 1; min-width: 0; border: 0; background: none; font-size: 1.15rem; outline: none; padding: 0.4rem 0; }
  .field input::-webkit-search-cancel-button { display: none; }
  .close { border: 1.5px solid var(--ww-rule-2); background: none; border-radius: 0.4rem; padding: 0.2rem 0.5rem; font-size: 0.78rem; cursor: pointer; color: var(--ww-ink-3); min-height: 2rem; }
  .results { list-style: none; margin: 0; padding: 0.5rem; overflow-y: auto; }
  .results :global(a) { display: flex; align-items: center; gap: 0.85rem; padding: 0.65rem 0.75rem; border-radius: var(--ww-radius); text-decoration: none; }
  .results :global([aria-selected='true'] a), .results :global(a:hover) { background: var(--ww-paper-2); }
  .results :global(.sw) { width: 2.6rem; height: 2.6rem; border-radius: 0.7rem; flex: none; border: 2px solid var(--ww-ink); object-fit: cover; background: var(--ww-paper-2); }
  .results :global(.tx) { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .results :global(.tx small) { color: var(--ww-ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .results :global(.mt) { font-size: 0.75rem; font-weight: 700; color: var(--ww-ink-3); white-space: nowrap; }
  .hint { padding: 0.6rem 1.25rem 0.9rem; font-size: 0.85rem; color: var(--ww-ink-3); border-top: 1.5px solid var(--ww-rule); }
  @media (max-width: 560px) { .results :global(.mt) { display: none; } .search { margin-top: 1rem; } }
</style>
