---
import type { SeriesSnapshot } from '../lib/series';
interface Props { s: SeriesSnapshot; headingLevel?: 'h2' | 'h3' }
const { s, headingLevel: H = 'h3' } = Astro.props;
const { def, preview } = s;
// "1 club = 1 stand" → highlight the middle noun like the videos do.
const [left, right] = def.rule.split('=').map((x) => x.trim());
const [n1, ...w1] = left.split(' ');
---
<article class="series-card" style={`--c1:${def.colors[0]}; --c2:${def.colors[1]}; --acc:${def.accent}`} data-series-card data-state-url={s.stateUrl} data-reveal>
  <div class="top">
    <span class="emoji" aria-hidden="true">{def.emoji}</span>
    <span class="day"><span class="live-dot" aria-hidden="true"></span>Day <b data-k="day">{s.day}</b></span>
  </div>
  <p class="name">{def.name}</p>
  <H class="rule"><a href={def.url}>{n1} <em>{w1.join(' ')}</em> = {right}</a></H>
  <p class="blurb">{def.blurb}</p>
  {(preview.stat !== undefined || (preview.top?.length ?? 0) > 0) && (
    <div class="live">
      {preview.stat !== undefined && <p class="stat"><b data-k="stat">{preview.stat}</b> <span data-k="statLabel">{preview.statLabel}</span></p>}
      {preview.top && preview.top.length > 0 && (
        <ol class="podium" data-k="top">
          {preview.top.slice(0, 3).map((t) => <li><span>{t.label}</span>{t.sub && <small>{t.sub}</small>}</li>)}
        </ol>
      )}
    </div>
  )}
  <form class="find" action={def.url} method="get" data-find>
    <label class="sr-only" for={`find-${def.id}`}>Find your name in {def.name}</label>
    <input id={`find-${def.id}`} name="q" placeholder="@yourname" autocomplete="off" />
    <button type="submit" aria-label={`Find my name in ${def.name}`}>Find me</button>
  </form>
  <div class="ctas">
    <a class="open" href={def.url}>Open live map <span aria-hidden="true">→</span></a>
    <a class="ep" href={s.latestEpisode} rel="noopener">{def.verb} <span aria-hidden="true">↗</span></a>
  </div>
</article>

<style>
  .series-card {
    position: relative; display: flex; flex-direction: column; gap: 0.7rem; padding: 1.4rem; overflow: hidden;
    border: 2px solid var(--ww-ink); border-radius: var(--ww-radius-lg); color: #fff;
    background: radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--c2) 70%, transparent), transparent 60%), linear-gradient(160deg, var(--c1), color-mix(in oklab, var(--c1) 70%, #000));
    box-shadow: 0 0 0 var(--ww-ink); transition: transform var(--ww-dur) var(--ww-ease-out), box-shadow var(--ww-dur) var(--ww-ease-out);
  }
  .series-card:hover, .series-card:focus-within { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--ww-ink); }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .emoji { font-size: 2.2rem; line-height: 1; filter: drop-shadow(0 4px 6px rgb(0 0 0 / 0.3)); }
  .day { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.25rem 0.7rem; border-radius: var(--ww-radius-pill); background: rgb(0 0 0 / 0.35); border: 1.5px solid rgb(255 255 255 / 0.5); font-family: var(--ww-font-display); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .live-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #ff4f7b; animation: ww-live 1.6s infinite; }
  @keyframes ww-live { 70% { box-shadow: 0 0 0 7px rgb(255 79 123 / 0); } 0% { box-shadow: 0 0 0 0 rgb(255 79 123 / 0.6); } }
  .name { font-family: var(--ww-font-display); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.9; }
  .rule { color: #fff; font-size: clamp(1.6rem, 2.6vw, 2.1rem); font-weight: 800; letter-spacing: -0.035em; text-transform: uppercase; text-shadow: 0 3px 0 rgb(0 0 0 / 0.35); }
  .rule a { text-decoration: none; }
  .rule a::after { content: ''; position: absolute; inset: 0; z-index: 0; }
  .rule em { font-style: normal; color: var(--acc); }
  .blurb { color: rgb(255 255 255 / 0.88); font-size: 0.98rem; }
  .live { display: grid; gap: 0.5rem; padding: 0.8rem 1rem; border-radius: var(--ww-radius); background: rgb(0 0 0 / 0.32); border: 1.5px solid rgb(255 255 255 / 0.25); }
  .stat b { font-family: var(--ww-font-display); font-size: 1.5rem; letter-spacing: -0.03em; color: var(--acc); }
  .stat span { font-weight: 600; opacity: 0.9; }
  .podium { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.2rem; counter-reset: p; }
  .podium li { display: flex; gap: 0.5rem; align-items: baseline; font-weight: 700; counter-increment: p; }
  .podium li::before { content: counter(p); font-family: var(--ww-font-display); color: var(--acc); width: 1rem; }
  .podium span { flex: 0 0 auto; max-width: 62%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .podium small { flex: 1 1 0; min-width: 0; text-align: right; opacity: 0.75; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .find { position: relative; z-index: 1; display: flex; gap: 0.4rem; margin-top: auto; }
  .find input { flex: 1; min-width: 0; min-height: 2.75rem; padding: 0 1rem; border-radius: var(--ww-radius-pill); border: 2px solid rgb(255 255 255 / 0.6); background: rgb(0 0 0 / 0.35); color: #fff; font-weight: 600; }
  .find input::placeholder { color: rgb(255 255 255 / 0.65); }
  .find button { min-height: 2.75rem; padding: 0 1rem; border-radius: var(--ww-radius-pill); border: 2px solid var(--ww-ink); background: var(--acc); color: var(--ww-ink); font-weight: 800; cursor: pointer; box-shadow: 0 3px 0 var(--ww-ink); }
  .ctas { position: relative; z-index: 1; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; }
  .ctas a { display: inline-flex; align-items: center; min-height: 2.5rem; font-weight: 800; color: #fff; }
  .ep { opacity: 0.85; }
</style>

<script>
  // Search box → deep link (?u=handle or ?q=text) on the series subdomain.
  document.querySelectorAll<HTMLFormElement>('[data-series-card] [data-find]').forEach((form) =>
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = (new FormData(form).get('q') as string).trim();
      const url = new URL(form.action);
      (window as unknown as { track?: (n: string, p: object) => void }).track?.('series_find', { series: url.host, query: v });
      if (v.startsWith('@')) url.searchParams.set('u', v.slice(1));
      else if (v) url.searchParams.set('q', v);
      location.href = url.toString();
    }),
  );
  // Refresh live numbers from each subdomain; silently keep the build-time snapshot on failure.
  const nf = new Intl.NumberFormat('en');
  document.querySelectorAll<HTMLElement>('[data-series-card]').forEach((card) => {
    const url = card.dataset.stateUrl;
    if (!url) return;
    fetch(url, { cache: 'no-cache' })
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((st: { day?: number; preview?: { stat?: number | string; statLabel?: string } }) => {
        const set = (k: string, v: unknown) => { const el = card.querySelector(`[data-k="${k}"]`); if (el && v !== undefined) el.textContent = typeof v === 'number' ? nf.format(v) : String(v); };
        set('day', st.day);
        set('stat', st.preview?.stat);
        set('statLabel', st.preview?.statLabel);
      })
      .catch(() => {});
  });
</script>
